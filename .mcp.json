                                              ]
                                 },
                       "wikipedia":  {
                                         "command":  "uvx",
                                         "args":  [
                                                      "wikipedia-mcp"
                                                  ]
                                     },
                       "sequential-thinking":  {
                                                   "command":  "cmd",
                                                   "args":  [
